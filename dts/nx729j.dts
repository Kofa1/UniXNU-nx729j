		cpu-map {
			/* The pinned ADT converter treats every enabled /cpus child as a CPU. */
			status = "disabled";

			cluster0 {

				core0 {
					cpu = <0x18>;
				};

				core1 {
					cpu = <0x19>;
				};

				core2 {
					cpu = <0x1a>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x1b>;
				};

				core1 {
					cpu = <0x1c>;
				};

				core2 {
					cpu = <0x1d>;
				};

				core3 {
					cpu = <0x1e>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x1f>;
				};
			};
		};
	};

